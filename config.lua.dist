-- TFS Rust `config.lua` template. Copy to `config.lua` (gitignored).
-- Keys here are ones the Rust server actually reads. C++ TFS leftovers
-- (houses/market/status protocol, Windows process priority, script converter,
-- TFS-only skull ladders, unused item-use knobs) are omitted — they were no-ops.

-- Protocol (772 = 7.72 default, 1098 = 10.98). Override: TFS_PROTOCOL_VERSION.
clientVersion = 772

-- Network. TFS_LOGIN_ADDR / TFS_GAME_ADDR override binds; TFS_PUBLIC_IP /
-- TFS_GAME_PORT override what the character list advertises.
worldType = "pvp" -- "pvp" | "no-pvp" | "pvp-enforced"
ip = "127.0.0.1"
bindOnlyGlobalAddress = false
loginProtocolPort = 7171
gameProtocolPort = 7172
statusProtocolPort = 7171
-- Login MOTD / world name. TFS_MOTD / TFS_SERVER_NAME override when set.
serverName = "Forgotten"
motd = "Welcome to The Forgotten Server!"

-- MySQL. DATABASE_URL overrides the mysql* URL (not pool size).
mysqlHost = "127.0.0.1"
mysqlUser = "forgottenserver"
mysqlPass = ""
mysqlDatabase = "forgottenserver"
mysqlPort = 3306
mysqlSock = ""
mysqlConnectionPoolSize = 1
mysqlConnectionMaxPoolSize = 5
mysqlConnectionTimeout = 300
mysqlConnectionAcquireTimeout = 10

-- Auth. 40-hex SHA1 hashes upgrade to bcrypt on successful login.
legacySha1Enabled = true
passwordHashCost = 12

-- PvP / logout lock. 772 CheckPlayerkilling uses the day/week/month windows
-- below, not TFS killsToRedSkull / killsToBlackSkull / timeToDecreaseFrags.
protectionLevel = 1
pzLocked = 60000 -- ms; 60000 ≡ 772 BlockLogout(60)
whiteSkullTime = 15 * 60 -- seconds; ≡ 772 BlockLogout(900)
redSkullDuration = 30 * 24 * 60 * 60
unjustDaySeconds = 86000 -- 772 day window is 86000, not 86400
unjustWeekSeconds = 7 * 24 * 60 * 60
unjustMonthSeconds = 30 * 24 * 60 * 60
killsDayRedSkull = 3
killsWeekRedSkull = 5
killsMonthRedSkull = 10
killsDayBanishment = 6
killsWeekBanishment = 10
killsMonthBanishment = 20
banDaysLength = 30

-- Rates. expStages = false → flat rateExp. true → experienceStages table.
rateExp = 5
rateSkill = 3
rateLoot = 2
rateMagic = 3
rateSpawn = 1
expStages = false
experienceStages = {
	{ minlevel = 1, maxlevel = 8, multiplier = 7 },
	{ minlevel = 9, maxlevel = 20, multiplier = 6 },
	{ minlevel = 21, maxlevel = 50, multiplier = 5 },
	{ minlevel = 51, maxlevel = 100, multiplier = 4 },
	{ minlevel = 101, multiplier = 3 }
}

-- Death: -1 = default formula; 0..100 = fixed percent; 0 = no skill/exp loss.
deathLosePercent = -1

-- World
allowChangeOutfit = true
freePremium = false -- true = every account is premium
kickIdlePlayerAfterMinutes = 15
maxMessageBuffer = 4
yellMinimumLevel = 2
yellAlwaysAllowPremium = false
depotFreeLimit = 2000
depotPremiumLimit = 10000
defaultWorldLight = true -- false lets Lua setWorldLight win
itemsDecayInsideDepots = false

-- Monster despawn / walk-back
deSpawnRange = 2
deSpawnRadius = 50
removeOnDespawn = true
walkToSpawnRadius = 15

-- Lua VM (tasks/tools-actions/vm-hardening.md pillar 4).
-- luaMemoryLimit: MB. Runaway allocation errors the script instead of OOM.
luaMemoryLimit = 512
-- luaInstructionBudget: VM instructions per script invocation. 0 disables the
-- hook and keeps LuaJIT (a runaway script can then hang the game thread).
-- Abort does not roll back mutations already applied in that callback.
luaInstructionBudget = 10000000

-- Daily save clock (replaces XML GlobalEvent time="04:30:00" / serversave.lua).
-- Warn online players `serverSaveNotifyDuration` minutes before the wall-clock
-- time, optionally close new logins, then flush. Shutdown exits the process;
-- false saves and stays in GAME_STATE_NORMAL.
serverSaveTime = "04:30:00"
serverSaveNotifyDuration = 5
serverSaveClose = true
serverSaveShutdown = true

-- Map Settings --
-- mapName selects the OTBM under data/world/: "forgotten" → forgotten.otbm,
-- "map" → map.otbm. The associated house file is always {mapName}-houses.xml
-- (forgotten-houses.xml / map-houses.xml). TFS_MAP_OTBM overrides mapName.
mapName = "forgotten"
mapAuthor = ""
