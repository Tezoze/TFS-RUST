# Copy to `.env` next to docker-compose.yml (optional; defaults match Compose).
# Prebuilt server image (GitHub Container Registry). Override for forks/tags.
TFS_IMAGE=ghcr.io/tezoze/tfs-rust:latest
MYSQL_PASSWORD=forgottenserver
MYSQL_ROOT_PASSWORD=forgottenserver
# Address clients use for the game world after login (host, not the container).
TFS_PUBLIC_IP=127.0.0.1
# RUST_LOG=info,tfs_rust_core=debug
